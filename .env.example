# Required target. Default shown is the public LoopGrid local Docker evaluation path.
LOOPGRID_BASE_URL=http://127.0.0.1:8000
LOOPGRID_WORKSPACE=default

# Optional in local auth-disabled evaluation. Required when the LoopGrid deployment enforces auth.
# When LoopGrid authentication is enabled, use a scoped service key with only the permissions required by the tools you enable.
LOOPGRID_SERVICE_KEY=

# Evidence ZIP output directory used by loopgrid.get_evidence.
LOOPGRID_EVIDENCE_DIR=loopgrid-evidence
LOOPGRID_MAX_EVIDENCE_BYTES=52428800
LOOPGRID_MCP_TIMEOUT_SECONDS=20

# Safety defaults: both are OFF.
# Review is model-callable in MCP, so enable only in a host/workflow that requires human confirmation.
LOOPGRID_MCP_ENABLE_REVIEW_TOOL=false
LOOPGRID_MCP_REVIEWER_ID=

# FULL-mode raw disclosures are not exported through MCP unless explicitly enabled.
LOOPGRID_MCP_ALLOW_PAYLOAD_EXPORT=false
